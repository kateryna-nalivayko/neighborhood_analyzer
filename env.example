# Скопіюйте цей файл у .env і впишіть свої значення.
# Файл .env НЕ завантажується на GitHub (він у .gitignore).

# Токен від @BotFather у Telegram
TELEGRAM_BOT_TOKEN=1234567890:AAAA-your-telegram-token

# API-ключ з Google Cloud Console (APIs & Services → Credentials).
# Увімкніть для проєкту: Geocoding API, Places API (New), Air Quality API.
GOOGLE_MAPS_API_KEY=AIza-your-google-api-key

# Необов'язково
# Радіус пошуку місць, м
DEFAULT_RADIUS=1000
LANGUAGE=uk
REGION=UA
CACHE_TTL_SECONDS=3600
